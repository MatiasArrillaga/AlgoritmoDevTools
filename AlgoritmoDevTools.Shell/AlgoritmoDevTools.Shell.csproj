<!--
  Sdk.Razor y no Sdk a secas: el host de un BlazorWebView necesita que el proyecto genere su propio
  manifiesto de recursos estaticos. Sin eso no se sirve _framework/blazor.webview.js, la pagina se
  queda en "Cargando..." y no hay ningun error que lo explique.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevTools.Shell</RootNamespace>
    <StartupObject>AlgoritmoDevTools.Shell.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Publish: un solo .exe autocontenido con el runtime de .NET 10 y todos los DLLs embebidos.
      Para generar el exe:   dotnet publish -c Release
      Salida en:             bin\Release\net10.0-windows\win-x64\publish\AlgoritmoDevTools.Shell.exe
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyName>DevTools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlgoritmoDevTools.Core\AlgoritmoDevTools.Core.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Integrations.SoftCerealCore\AlgoritmoDevTools.Integrations.SoftCerealCore.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Tools.CommandsMaker\AlgoritmoDevTools.Tools.CommandsMaker.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Tools.MarkdownConverter\AlgoritmoDevTools.Tools.MarkdownConverter.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Tools.ModelDriftChecker\AlgoritmoDevTools.Tools.ModelDriftChecker.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Tools.SecretsManager\AlgoritmoDevTools.Tools.SecretsManager.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.Tools.TyeServiceSelector\AlgoritmoDevTools.Tools.TyeServiceSelector.csproj" />
    <ProjectReference Include="..\AlgoritmoDevTools.UI\AlgoritmoDevTools.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>

    <!--
      Los dos del widget. El nombre dice sobre qué fondo van, no de qué color son: el de la
      barra clara lleva el trazo oscuro, y al revés.
    -->
    <EmbeddedResource Include="Assets\bandeja-clara.ico">
      <LogicalName>bandeja-clara.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\bandeja-oscura.ico">
      <LogicalName>bandeja-oscura.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.110" />
  </ItemGroup>

  <!--
    El contenido web —el index.html, el CSS de la interfaz, el blazor.webview.js— viaja incrustado en
    el ensamblado y no como archivos al lado del .exe.

    El SDK lo trata como si atras hubiera un servidor web que lo va a leer del disco: lo copia a una
    carpeta wwwroot y lo deja afuera del archivo unico, sin forma de pedirle lo contrario. Aca no hay
    servidor —el visor pide cada archivo por su ruta y se lo contesta ContenidoWebEmbebido—, asi que
    se toma la lista que arma el propio SDK y se incrusta antes de compilar.

    Se toman los Primary: los Alternative son las copias comprimidas (.gz, .br), que existen para
    ahorrar ancho de banda en una descarga y aca no tienen a quien servirle.
  -->
  <Target Name="EmbeberElContenidoWeb" DependsOnTargets="ResolveStaticWebAssetsInputs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_ContenidoWeb Include="@(StaticWebAsset)" Condition="'%(StaticWebAsset.AssetRole)' == 'Primary'">
        <!--
          El SDK nombra los archivos dejando un hueco para la version: "index#[.{fingerprint}]?.html".
          La ruta que pide el navegador es la de siempre, asi que el hueco se saca. La segunda pasada
          junta las barras repetidas, porque los archivos de la raiz traen el BasePath en "/".
        -->
        <RutaWeb>$([System.Text.RegularExpressions.Regex]::Replace('%(StaticWebAsset.BasePath)/%(StaticWebAsset.RelativePath)', '#\[[^\]]*\]\??', ''))</RutaWeb>
      </_ContenidoWeb>
      <EmbeddedResource Include="@(_ContenidoWeb)">
        <LogicalName>$([System.Text.RegularExpressions.Regex]::Replace('web/%(_ContenidoWeb.RutaWeb)', '/+', '/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!--
    Deja sólo el .exe en el folder de publish: los PDB y XML de los proyectos referenciados, y la
    copia del contenido web que el SDK deja al lado aunque ya viaje adentro del ejecutable.
  -->
  <Target Name="CleanupPublishOutputs" AfterTargets="Publish">
    <ItemGroup>
      <PublishExtras Include="$(PublishDir)*.pdb" />
      <PublishExtras Include="$(PublishDir)*.xml" />
      <PublishExtras Include="$(PublishDir)*.staticwebassets.endpoints.json" />
    </ItemGroup>
    <Delete Files="@(PublishExtras)" />
    <RemoveDir Directories="$(PublishDir)wwwroot" />
  </Target>

</Project>
