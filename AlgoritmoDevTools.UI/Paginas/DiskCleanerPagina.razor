@using AlgoritmoDevTools.Tools.DiskCleaner.Model
@using AlgoritmoDevTools.Tools.DiskCleaner.Services

@*
    Limpieza de disco: muestra qué ocupa el disco, explica qué se pierde al borrar cada cosa y
    limpia sólo lo que el usuario tilde.

    La barra de arriba es el total honesto. El tramo "ocupado" es anónimo a propósito —no se
    desglosa ni se abre— porque ahí adentro está lo que no se debe borrar, y nombrarlo es la
    tentación que el catálogo evita: alguien lee la ruta y la borra por fuera de la herramienta.

    El espacio libre se lee una sola vez, al escanear, y no se usa para medir nada: dos lecturas
    separadas por minutos dieron 6,9 y 40 GB sin que nadie tocara el disco.

    Referencia funcional y técnica:
    AlgoritmoDevTools.Tools.DiskCleaner/README.referencia-tecnica-funcional-limpieza-disco.md
*@

<TituloDePagina Texto="Disk Cleaner"
                Ayuda="Mide qué ocupa el disco, explica el riesgo de cada cosa y limpia sólo lo que elijas. Nada se borra sin que lo tildes." />

@* Sin margen propio: la fila va directo bajo la línea del título, así que toma el del sistema. *@
<div class="fila">
    @if (_escaneando)
    {
        <button type="button" class="btn btn-secundario" @onclick="Cancelar">Cancelar</button>
        <span class="sub">Midiendo…</span>
    }
    else if (Elegido() > 0)
    {
        @* Con algo elegido, la acción primaria es limpiarlo: volver a analizar pasa a secundaria. *@
        <button type="button" class="btn btn-primario" @onclick="AlternarConfirmacion">
            Limpiar lo elegido (@Tamano(Elegido()))
        </button>
        <button type="button" class="btn btn-secundario" @onclick="Escanear">Volver a analizar</button>
    }
    else
    {
        <button type="button" class="btn btn-primario" @onclick="Escanear">
            @(_escaneo is null ? "Analizar el disco" : "Volver a analizar")
        </button>
        @if (_escaneo is not null)
        {
            <span class="sub">@Resumen()</span>
        }
    }
</div>

@if (_plan is not null)
{
    <div class="confirmacion">
        @if (_plan.EstaVacio)
        {
            <p>No quedó nada para limpiar.</p>
        }
        else
        {
            <p>
                Se van a borrar <b>@Tamano(_plan.Bytes)</b> en @_plan.Rutas @(_plan.Rutas == 1 ? "ubicación" : "ubicaciones"),
                de @_plan.Items.Count @(_plan.Items.Count == 1 ? "cosa" : "cosas").
            </p>

            <ul class="lista-plan">
                @foreach (var entrada in _plan.Items)
                {
                    <li>
                        <b>@Tamano(entrada.Bytes)</b> — @entrada.Item.Ubicacion
                        @if (entrada.Item.ComoSeRevierte is null)
                        {
                            <span class="estado-advertencia"> no se puede deshacer</span>
                        }
                    </li>
                }
            </ul>

            @if (SinVuelta().Count > 0)
            {
                <p class="estado-error">
                    Esto no se puede deshacer: @string.Join(", ", SinVuelta().Select(i => i.Item.Ubicacion)).
                </p>

                <p>Para confirmar, escribí <b>@PalabraDeConfirmacion</b>:</p>
                <div class="fila">
                    <input class="campo" style="max-width:200px"
                           aria-label="Escribí la palabra de confirmación"
                           @bind="_confirmacionEscrita" @bind:event="oninput" />
                </div>
            }

            @if (_plan.NecesitaElevar)
            {
                <p class="sub">Algo de esto necesita permiso de administrador. Se va a pedir una sola vez, al final.</p>
            }
        }

        @if (_plan.Descartados.Count > 0)
        {
            <p class="sub">Queda afuera:</p>
            <ul class="lista-plan sub">
                @foreach (var motivo in _plan.Descartados)
                {
                    <li>@motivo</li>
                }
            </ul>
        }

        <div class="acciones">
            <button type="button" class="btn btn-primario" disabled="@(!SePuedeConfirmar() || _borrando)" @onclick="Borrar">
                @(_borrando ? "Borrando…" : "Borrar")
            </button>
            <button type="button" class="btn btn-secundario" disabled="@_borrando" @onclick="CerrarConfirmacion">Cancelar</button>
        </div>
    </div>
}

@if (_resultado is not null)
{
    <TituloDeGrupo Texto="Qué pasó"
                   Ayuda="Lo liberado sale de sumar lo que pesaba cada cosa antes de borrarla, no de mirar el espacio libre del disco: ese número se mueve solo." />

    <p>
        Se liberaron <b>@Tamano(_resultado.BytesLiberados)</b> en @_resultado.Borradas
        @(_resultado.Borradas == 1 ? "ubicación" : "ubicaciones").
        @if (_resultado.Fallidas > 0)
        {
            <span class="estado-advertencia">Quedaron @_resultado.Fallidas sin borrar.</span>
        }
    </p>

    <ul class="lista-plan">
        @foreach (var porItem in _resultado.Items)
        {
            <li>
                <b>@Tamano(porItem.BytesLiberados)</b> — @porItem.Item.Ubicacion
                @if (porItem.Fallos.Count > 0)
                {
                    <span class="sub"> · @porItem.Fallos.Count sin borrar</span>
                }
            </li>
        }
    </ul>

    @if (_resultado.Fallidas > 0)
    {
        <TituloDeGrupo Texto="Lo que quedó sin borrar"
                       Ayuda="Nada de esto se fuerza. Si algo está tomado por un programa, lo que dice acá es cuál, para que decidas vos si lo cerrás." />

        <ul class="lista-plan">
            @foreach (var fallo in _resultado.Items.SelectMany(i => i.Fallos))
            {
                <li>
                    @fallo.Ruta
                    <span class="sub"> — @fallo.Motivo</span>
                    @if (fallo.Quien.Count > 0)
                    {
                        <span class="estado-advertencia"> Lo tiene @string.Join(", ", fallo.Quien.Select(q => $"{q.Nombre} ({q.Pid})")).</span>
                    }
                </li>
            }
        </ul>
    }

    @if (_resultado.ParaElevar.Count > 0)
    {
        <p class="estado-advertencia">
            Falta @Tamano(_resultado.ParaElevar.Sum(i => i.Bytes)) que necesita permiso de administrador:
            @string.Join(", ", _resultado.ParaElevar.Select(i => i.Item.Ubicacion)).
        </p>
        <div class="acciones">
            <button type="button" class="btn btn-primario" disabled="@_elevando" @onclick="ElevarYBorrar">
                @(_elevando ? "Esperando el permiso…" : "Pedir permiso y borrar el resto")
            </button>
            <button type="button" class="btn btn-secundario" disabled="@_elevando" @onclick="Escanear">Analizar de nuevo</button>
        </div>
    }
    else
    {
        <div class="acciones">
            <button type="button" class="btn btn-primario" @onclick="Escanear">Analizar de nuevo</button>
        </div>
    }
}

@if (_escaneo is not null)
{
    <TituloDeGrupo Texto="El disco"
                   Ayuda="Lo elegido y lo que se puede limpiar salen de lo medido. Ocupado es todo el resto, sin desglosar. Libre es lo que había al momento de analizar." />

    <div class="barra-disco" role="img" aria-label="@DescripcionDeLaBarra()">
        @foreach (var tramo in Tramos())
        {
            <div class="@tramo.Clase" style="width:@(tramo.Porcentaje.ToString("0.###", Cultura))%"></div>
        }
    </div>

    <div class="leyenda-disco">
        @foreach (var tramo in Tramos())
        {
            <span>
                <span class="@($"punto {tramo.Clase}")"></span>
                @tramo.Nombre
                <b>@Tamano(tramo.Bytes)</b>
            </span>
        }
    </div>

    @if (Elegido() > 0)
    {
        <p class="sub">Si limpiás lo elegido, el libre pasaría a @Tamano(_escaneo.Disco.Libre + Elegido()) — es una cuenta, no una medición.</p>
    }

    @foreach (var grupo in _items.GroupBy(i => i.Item.Grupo).OrderBy(g => g.Key))
    {
        var cual = grupo.Key;
        var estado = EstadoDelGrupo(cual);

        <TituloDeGrupo Texto="@(cual == GrupoLimpieza.Seguro ? "Seguro" : "Con criterio")"
                       Icono="@(cual == GrupoLimpieza.Seguro ? IconoSeguro : IconoConCriterio)"
                       ClaseDelIcono="@(cual == GrupoLimpieza.Seguro ? "es-seguro" : "es-con-criterio")"
                       Detalle="@TotalDelGrupo(cual)"
                       Contraido="@EstaContraido(cual)"
                       AlAlternar="@(_ => AlternarGrupo(cual))"
                       Ayuda="@(cual == GrupoLimpieza.Seguro
                                  ? "Vuelve solo: compilados, descargas, temporales. Viene tildado."
                                  : "Depende de cómo trabajes, y algunas cosas no se recuperan. Viene destildado y conviene leer qué se pierde.")" />

        @if (!EstaContraido(cual))
        {
            <table class="grilla-disco">
                <thead>
                    <tr>
                        <th class="col-tilde">
                            <input type="checkbox"
                                   class="chk"
                                   checked="@(estado is EstadoDelTilde.Todos)"
                                   data-parcial="@((estado is EstadoDelTilde.Algunos).ToString().ToLowerInvariant())"
                                   disabled="@(!HayElegibles(cual))"
                                   aria-label="@($"Tildar todo lo del grupo {cual}")"
                                   @onchange="e => TildarGrupo(cual, e.Value is true)" />
                        </th>
                        <th>Ubicación</th>
                        <th class="col-tamano">Tamaño</th>
                        <th>Qué es</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ofrecido in grupo)
                    {
                        var actual = ofrecido;
                        var abierto = Seleccionado(actual);

                        <tr class="@(abierto ? "elegida" : null)" @onclick="() => Seleccionar(actual)">
                            <td class="col-tilde">
                                <input type="checkbox"
                                       class="chk"
                                       checked="@actual.Tildado"
                                       disabled="@(!actual.Item.SePuedeElegir)"
                                       aria-label="@actual.Item.Ubicacion"
                                       @onclick:stopPropagation="true"
                                       @onchange="e => Tildar(actual, e.Value is true)" />
                            </td>
                            <td>@actual.Item.Ubicacion</td>
                            <td class="col-tamano">@Tamano(actual.Item.Bytes)</td>
                            <td class="sub">@actual.Item.Descripcion</td>
                        </tr>

                        @if (abierto)
                        {
                            <tr class="detalle">
                                <td></td>
                                <td colspan="3">
                                    <p><b>Si lo borrás:</b> @actual.Item.Consecuencia</p>

                                    <p class="sub">
                                        @(actual.Item.ComoSeRevierte is null
                                            ? "No se puede deshacer."
                                            : $"Se puede volver atrás: {actual.Item.ComoSeRevierte}")
                                        @if (actual.Item.RequiereAdmin)
                                        {
                                            <text> Hace falta permiso de administrador, que se pide una sola vez al final.</text>
                                        }
                                    </p>

                                    @if (actual.Item.MotivoParaNoTocarlo is not null)
                                    {
                                        <p class="estado-advertencia">@actual.Item.MotivoParaNoTocarlo</p>
                                    }

                                    @if (actual.Item.Bloqueantes.Count > 0)
                                    {
                                        <p class="estado-advertencia">
                                            En ejecución: @string.Join(", ", actual.Item.Bloqueantes.Select(b => b.Nombre).Distinct()).
                                            @(actual.Item.SeBorra
                                                ? "Algo puede fallar; se reintenta y se informa qué quedó sin borrar."
                                                : "Conviene esperar a que termine.")
                                        </p>
                                    }

                                    @if (actual.Item.Rutas.Count > 0)
                                    {
                                        <p class="sub">@string.Join(" · ", actual.Item.Rutas.Take(3))@(actual.Item.Rutas.Count > 3 ? $" y {actual.Item.Rutas.Count - 3} más" : "")</p>
                                    }

                                    <div class="fila">
                                        @if (actual.Item.Derivacion is { } derivacion && !string.IsNullOrWhiteSpace(derivacion.Destino))
                                        {
                                            <button type="button" class="btn btn-secundario"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => Derivar(derivacion)">@derivacion.Texto</button>
                                        }
                                        <button type="button" class="btn btn-secundario"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => AlternarIgnorar(actual)">No ofrecerme esto</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }

    @if (_ignorados > 0)
    {
        <p class="sub">
            Hay @_ignorados @(_ignorados == 1 ? "cosa que pediste no ver" : "cosas que pediste no ver").
            <button type="button" class="btn btn-secundario" @onclick="MostrarTodoDeNuevo">Volver a ofrecérmelas</button>
        </p>
    }

    @if (_escaneo.Fallaron.Count > 0)
    {
        <p class="sub">No se pudo medir: @string.Join(", ", _escaneo.Fallaron). El resto de lo que ves es correcto.</p>
    }
}
