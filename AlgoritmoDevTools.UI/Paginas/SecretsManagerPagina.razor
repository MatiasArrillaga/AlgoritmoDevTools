@using AlgoritmoDevTools.Core.Infrastructure
@using AlgoritmoDevTools.Integrations.SoftCerealCore
@using AlgoritmoDevTools.Tools.SecretsManager.Services
@using AlgoritmoDevTools.UI.Servicios

@*
    Secrets Manager: administra los user-secrets de conexión a SQL de SoftCerealCore.

    El editor de conexión y la confirmación de borrado viven en la página y no en diálogos aparte:
    el visor no muestra las ventanas del navegador, y abrir un formulario de Windows Forms desde acá
    sería mezclar las dos interfaces.
*@

<TituloDePagina Texto="Secrets Manager" />

<p class="grupo">Conexiones guardadas</p>

<div class="fila" style="margin-top:0">
    <select class="campo" style="max-width:360px" value="@_conexionElegidaId" @onchange="CambiarConexion">
        <option value="0">(ninguna)</option>
        @foreach (var conexion in _conexiones)
        {
            <option value="@conexion.Id">@conexion.ToString()</option>
        }
    </select>

    <button type="button" class="btn btn-secundario" @onclick="NuevaConexion">Nueva</button>
    <button type="button" class="btn btn-secundario" disabled="@(ConexionActual() is null)" @onclick="ModificarConexion">Modificar</button>
    <button type="button" class="btn btn-secundario" disabled="@(ConexionActual() is null)" @onclick="AlternarEliminarConexion">Eliminar</button>
</div>

@if (_editando is not null)
{
    <div class="confirmacion">
        <p><b>@(_editandoId == 0 ? "Nueva conexión" : "Editar conexión")</b></p>

        <label class="chk">
            <input type="checkbox" checked="@_editando.UseIntegratedSecurity"
                   @onchange="e => _editando.UseIntegratedSecurity = e.Value is true" />
            <span>Autenticación Windows (Integrated Security)</span>
        </label>

        <div class="fila">
            <input class="campo" style="max-width:240px" placeholder="Server" @bind="_editando.Server" @bind:event="oninput" />
            @if (!_editando.UseIntegratedSecurity)
            {
                <input class="campo" style="max-width:180px" placeholder="User Id" @bind="_editando.User" @bind:event="oninput" />
                <input class="campo" style="max-width:180px" type="password" placeholder="Password" @bind="_editando.Password" @bind:event="oninput" />
            }
        </div>

        <div class="acciones">
            <button type="button" class="btn btn-primario" @onclick="GuardarConexion">Guardar</button>
            <button type="button" class="btn btn-secundario" disabled="@_probando" @onclick="ProbarConexion">Probar conexión</button>
            <button type="button" class="btn btn-secundario" @onclick="() => _editando = null">Cancelar</button>
        </div>

        @if (!string.IsNullOrEmpty(_estadoPrueba))
        {
            <p class="linea-estado @_claseEstadoPrueba">@_estadoPrueba</p>
        }
    </div>
}

@if (_eliminandoConexion && ConexionActual() is { } aEliminar)
{
    <div class="confirmacion">
        <p>¿Eliminar la conexión <b>@aEliminar.ToString()</b>?</p>
        <div class="acciones">
            <button type="button" class="btn btn-primario" @onclick="EliminarConexion">Eliminar</button>
            <button type="button" class="btn btn-secundario" @onclick="() => _eliminandoConexion = false">Cancelar</button>
        </div>
    </div>
}

<p class="grupo">Base de datos</p>

<div class="fila" style="margin-top:0">
    <select class="campo" style="max-width:300px" value="@_baseElegida" disabled="@(!_basesHabilitadas)"
            @onchange="e => _baseElegida = e.Value?.ToString() ?? string.Empty">
        @foreach (var nombre in _bases)
        {
            <option value="@nombre">@nombre</option>
        }
    </select>
    <button type="button" class="btn btn-primario" disabled="@(_ocupado || ConexionActual() is null)" @onclick="AplicarSecreto">
        Aplicar a los secretos
    </button>
</div>

<p class="grupo">Secretos</p>

<div class="fila" style="margin-top:0">
    <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="ListarSecretos">Listar secretos</button>
    <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="RestaurarSecretos">Restaurar secretos</button>
</div>

@if (!string.IsNullOrEmpty(_visor))
{
    <pre class="salida">@_visor</pre>
}

<p class="grupo">Menú contextual del explorador</p>

<div class="fila" style="margin-top:0">
    <button type="button" class="btn btn-secundario" @onclick="InstalarMenu">
        @(_menuInstalado ? "Regenerar menú" : "Agregar al menú")
    </button>
    <button type="button" class="btn btn-secundario" disabled="@(!_menuInstalado)" @onclick="QuitarMenu">Quitar del menú</button>
</div>

<p class="linea-estado @_claseEstadoMenu">@_estadoMenu</p>
