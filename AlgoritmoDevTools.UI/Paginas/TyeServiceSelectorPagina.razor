@using AlgoritmoDevTools.Core.Infrastructure
@using AlgoritmoDevTools.Tools.TyeServiceSelector.Services
@using AlgoritmoDevTools.UI.Servicios

@*
    Selector de Servicios (Tye): elige qué microservicios levanta el entorno local, escribe el
    tye.devtools.yaml a partir del tye.yaml maestro —que nunca se modifica— y arranca tye.

    Antes de arrancar muestra un pre-vuelo con los servicios elegidos, contra qué base van a
    levantar y qué le falta al entorno: darse cuenta después cuesta el ciclo completo.

    'seguridad' y 'ui' no se pueden destildar, y 'orquestador' se propone tildado cada vez que la
    pantalla arma la selección entera. La regla vive en el code-behind (ServiciosObligatorios y
    ServicioSugerido) y está duplicada en Views/TyeServiceSelectorView.cs, la ventana clásica.

    Referencia funcional y técnica:
    AlgoritmoDevTools.Tools.TyeServiceSelector/README.referencia-tecnica-funcional-selector-de-servicios.md.
*@

<TituloDePagina Texto="Selector de Servicios (Tye)" Ayuda="Genera tye.devtools.yaml con los servicios que elijas. El maestro no se toca." />

<p class="grupo">Perfil</p>

<div class="fila" style="margin-top:0">
    <select class="campo" style="max-width:280px" value="@_perfilElegido" @onchange="CambiarPerfil">
        <option value="@SinPerfil">@SinPerfil</option>
        @foreach (var nombre in _nombresDePerfil)
        {
            <option value="@nombre">@nombre</option>
        }
    </select>
    <button type="button" class="btn btn-secundario" @onclick="AlternarGuardarPerfil">Guardar perfil</button>
    <button type="button" class="btn btn-secundario" disabled="@(PerfilActual() is null)" @onclick="AlternarEliminarPerfil">Eliminar perfil</button>
</div>

@if (_guardandoPerfil)
{
    <div class="confirmacion">
        <p>Nombre del perfil:</p>
        <div class="fila">
            <input class="campo" style="max-width:280px" @bind="_nombreNuevoPerfil" @bind:event="oninput"
                   @onkeydown="TeclaEnNombreDePerfil" />
            <button type="button" class="btn btn-primario" @onclick="GuardarPerfil">Guardar</button>
            <button type="button" class="btn btn-secundario" @onclick="() => _guardandoPerfil = false">Cancelar</button>
        </div>
    </div>
}

@if (_eliminandoPerfil)
{
    <div class="confirmacion">
        <p>¿Eliminar el perfil <b>@PerfilActual()</b>?</p>
        <div class="acciones">
            <button type="button" class="btn btn-primario" @onclick="EliminarPerfil">Eliminar</button>
            <button type="button" class="btn btn-secundario" @onclick="() => _eliminandoPerfil = false">Cancelar</button>
        </div>
    </div>
}

<p class="grupo">Servicios</p>

<div class="fila" style="margin-top:0">
    <button type="button" class="btn btn-secundario" @onclick="Releer">Refrescar</button>
    <button type="button" class="btn btn-secundario" @onclick="() => MarcarTodos(true)">Marcar todos</button>
    <button type="button" class="btn btn-secundario" @onclick="() => MarcarTodos(false)">Desmarcar todos</button>
</div>

@if (_servicios.Count > 0)
{
    <div class="lista-chk columnas">
        @foreach (var servicio in _servicios)
        {
            var actual = servicio;
            <label class="chk" title="@TituloDe(actual.Nombre)">
                <input type="checkbox" checked="@actual.Activo" disabled="@EsObligatorio(actual.Nombre)"
                       @onchange="e => Alternar(actual, e)" />
                <span>@actual.Nombre</span>
            </label>
        }
    </div>
}

@if (_revision is not null)
{
    <p class="grupo">Entorno</p>

    <div class="fila" style="margin-top:0">
        @if (HayQueControlar)
        {
            <span>Ya hay un entorno corriendo. <b>Controlar</b> engancha la barra a esa instancia; no se levanta nada ni se cambia la base.</span>
        }
        else if (_revision.ErrorDeConexion is not null)
        {
            <span class="estado-error">@_revision.ErrorDeConexion</span>
        }
        else
        {
            <span>Va a levantar contra <b>@_revision.BaseDeDatos</b> en <span class="mono">@_revision.Servidor</span>.</span>
        }
    </div>

    @foreach (var faltante in _revision.Prerrequisitos.Faltantes)
    {
        var actual = faltante;
        <div class="fila" style="margin-top:0">
            <span class="estado-error">@actual.Que</span>
            @if (actual.NecesitaElevacion)
            {
                <button type="button" class="btn btn-secundario" disabled="@_ocupado"
                        @onclick="() => Destrabar(actual)">
                    Destrabar (pide permisos de administrador)
                </button>
            }
            else if (!string.IsNullOrWhiteSpace(actual.Remedio))
            {
                <span class="mono">@actual.Remedio</span>
            }
        </div>
    }

    @foreach (var aviso in _revision.Prerrequisitos.Avisos)
    {
        <p class="estado-advertencia">@aviso</p>
    }
}

<div class="acciones">
    <button type="button" class="btn btn-primario" disabled="@_ocupado" @onclick="Levantar"
            title="@(HayQueControlar
                ? "Ya hay un entorno corriendo: abre la barra enganchada a esa instancia"
                : "Genera el archivo, arranca tye y abre la barra")">
        @(HayQueControlar ? "Controlar" : "Levantar")
    </button>
    <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="Generar">Generar y guardar</button>
</div>
